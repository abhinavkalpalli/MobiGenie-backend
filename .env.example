# App
NODE_ENV=production

# API Gateway
API_GATEWAY_PORT=3000

# CORS — set to your frontend domain (no trailing slash)
CORS_ORIGIN=https://your-frontend-domain.com

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# RabbitMQ — update credentials to match your broker
RABBITMQ_URI=amqp://<user>:<password>@rabbitmq:5672
RABBITMQ_USER=admin
RABBITMQ_PASS=REPLACE_WITH_STRONG_PASSWORD
RABBITMQ_QUERY_QUEUE=query_queue
RABBITMQ_PHONE_QUEUE=phone_queue
RABBITMQ_AI_QUEUE=ai_queue

# Groq API
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_API_KEY

# Google OAuth
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID

# Monitoring
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
PROMETHEUS_PORT=9090
